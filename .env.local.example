# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://asttwswjqffuwupdmrqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Crypto payments ───────────────────────────────────────────────────
# NOWPayments is primary. Cryptomus is fallback (Phase 2).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=

# ── Local fiat top-ups ────────────────────────────────────────────────
# Korapay: NGN (card / transfer / pay-with-bank) and, once approved on the
# account, GHS via hosted checkout. One secret key across currencies.
KORAPAY_SECRET_KEY=
# FX slippage buffer (basis points) per currency. Default 300 = 3%.
NGN_FX_BUFFER_BPS=300
GHS_FX_BUFFER_BPS=300

# MTN MoMo (Ghana) — direct RequestToPay. Sandbox is self-serve; production
# keys come from MTN after Go-Live (KYC). Provision sandbox api user/key with:
#   node scripts/momo-provision.mjs   (needs MTN_MOMO_SUBSCRIPTION_KEY set)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com  # set the prod host after Go-Live

# Surface the Ghana (Cedi) top-up rail in the UI. Keep false until MoMo is live.
NEXT_PUBLIC_ENABLE_GHS=false

# ── Upstream OTP providers ────────────────────────────────────────────
# 5SIM is primary at MVP. SMSPool is added in Phase 2.
FIVESIM_API_KEY=
SMSPOOL_API_KEY=

# ── Email (transactional only) ────────────────────────────────────────
RESEND_API_KEY=

# ── Inngest (background jobs) ─────────────────────────────────────────
# Local dev: set INNGEST_DEV=1 below, leave EVENT_KEY/SIGNING_KEY blank.
# Production: fill EVENT_KEY/SIGNING_KEY from app.inngest.com, and DO NOT
# set INNGEST_DEV (or set it to a falsy value). Setting both is a security
# bug — dev mode skips signature verification.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ── Cloudflare Turnstile (signup + topup) ─────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Sentry ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of admin emails (auto-promotes profiles.is_admin in seed scripts).
ADMIN_EMAILS=
